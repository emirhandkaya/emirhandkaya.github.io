---
// Root language gate (spec §2): stored choice → navigator.language → redirect.
// No-JS fallback: <noscript> meta refresh to /tr/ plus visible links. noindex.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { LANGS, localizedPath, t } from '../i18n';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <Seo lang="tr" paths={{ tr: '', en: '' }} noindex />
    <script is:inline>
      (function () {
        let l = null;
        try {
          l = localStorage.getItem('lang');
        } catch {
          /* storage blocked: fall back to navigator.language */
        }
        if (l !== 'tr' && l !== 'en') l = /^tr\b/i.test(navigator.language || '') ? 'tr' : 'en';
        location.replace('/' + l + '/');
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/tr/" />
    </noscript>
  </head>
  <body>
    <main id="main" class="container gate stack">
      <h1>
        {t('tr', 'gate.title')}
        <span class="muted" lang="en">
          / {t('en', 'gate.title')}
        </span>
      </h1>
      <p class="muted">
        {t('tr', 'gate.body')} <span lang="en">{t('en', 'gate.body')}</span>
      </p>
      <ul class="cluster" role="list">
        {LANGS.map((l, i) => (
          <li>
            <a
              class={i === 0 ? 'button button--primary' : 'button'}
              href={localizedPath(l)}
              hreflang={l}
              lang={l}
            >
              {t(l, 'gate.link')}
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>

<style>
  .gate {
    padding-block: var(--space-8);
    --stack-space: var(--space-5);
  }
  .gate h1 {
    font-size: var(--step-4);
  }
  .gate ul {
    list-style: none;
    padding: 0;
  }
</style>
