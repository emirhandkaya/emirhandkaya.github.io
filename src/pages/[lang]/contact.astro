---
import Base from '../../layouts/Base.astro';
import { EMAIL, SOCIALS } from '../../data/site';
import { LANGS, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base
  lang={lang}
  title={t(lang, 'contact.title')}
  description={t(lang, 'contact.description')}
  path="contact"
>
  <div class="container">
    <header class="page-head">
      <h1>{t(lang, 'contact.title')}</h1>
      <p class="muted">{t(lang, 'contact.intro')}</p>
    </header>

    <section class="card email" aria-labelledby="email">
      <h2 id="email" class="mono label">
        {t(lang, 'contact.email')}
      </h2>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </section>

    <section class="elsewhere" aria-labelledby="elsewhere">
      <h2 id="elsewhere">{t(lang, 'contact.elsewhere')}</h2>
      <ul class="links" role="list">
        {SOCIALS.map((s) => (
          <li>
            <a class="card" href={s.url} rel="me noopener" target="_blank">
              <span>{t(lang, `social.${s.id}`)}</span>
              <span class="mono muted host">{new URL(s.url).hostname.replace(/^www\./, '')}</span>
              <span class="visually-hidden">{t(lang, 'a11y.newTab')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .email {
    display: grid;
    gap: var(--space-2);
  }
  .label {
    font-size: var(--step--1);
    font-weight: var(--weight-regular);
    color: var(--text-muted);
  }
  .email a {
    font-size: var(--step-2);
    font-weight: var(--weight-bold);
    overflow-wrap: anywhere;
  }
  .elsewhere {
    margin-block-start: var(--space-7);
    display: grid;
    gap: var(--space-4);
  }
  .elsewhere h2 {
    font-size: var(--step-1);
  }
  .links {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }
  .links a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--text);
    text-decoration: none;
  }
  .links a:hover {
    border-color: var(--accent);
  }
  .host {
    font-size: var(--step--1);
  }
  @media (min-width: 48rem) {
    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
