---
// Bio from research/profile-notes.md (OWNER-CV, Owner decisions, Browser pass).
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { LANGS, localizedPath, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const blocks = ['entrepreneur', 'robotics', 'sports', 'writing', 'education'] as const;
---

<Base lang={lang} title={t(lang, 'about.title')} description={t(lang, 'about.description')} path="about">
  <div class="container about">
    <header class="page-head">
      <h1>{t(lang, 'about.title')}</h1>
      <p class="lede">{t(lang, 'about.lede')}</p>
    </header>
    <div class="prose bio">
      {blocks.map((b) => (
        <p>{t(lang, `about.${b}`)}</p>
      ))}
    </div>
    <nav class="section" aria-labelledby="more">
      <SectionHead id="more" index={1} title={t(lang, 'about.more')} />
      <ul class="cluster more" role="list">
        <li>
          <a class="button" href={localizedPath(lang, 'projects')}>
            {t(lang, 'about.toProjects')}
          </a>
        </li>
        <li>
          <a class="button" href={localizedPath(lang, 'blog')}>
            {t(lang, 'about.toBlog')}
          </a>
        </li>
        <li>
          <a class="button" href="https://team10141.com/" rel="noopener" target="_blank">
            team10141.com ↗<span class="visually-hidden"> {t(lang, 'a11y.newTab')}</span>
          </a>
        </li>
        <li>
          <a class="button" href="https://www.valmeto.com/" rel="noopener" target="_blank">
            valmeto.com ↗<span class="visually-hidden"> {t(lang, 'a11y.newTab')}</span>
          </a>
        </li>
        <li>
          <a class="button button--primary" href={localizedPath(lang, 'contact')}>
            {t(lang, 'about.toContact')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</Base>

<style>
  .lede {
    font-size: var(--step-2);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: var(--measure);
  }
  .bio p {
    color: var(--text-muted);
  }
  .bio p::first-line {
    color: var(--text);
  }
  .more {
    list-style: none;
    padding: 0;
  }
</style>
