---
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { LANGS, t, tn, type Lang } from '../../../i18n';
import { getProjects, projectTags } from '../../../lib/projects';
import { tagSlug } from '../../../lib/tags';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const projects = await getProjects(lang);
const tags = projectTags(projects);
---

<Base
  lang={lang}
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.description')}
  path="projects"
>
  <div class="container">
    <header class="page-head">
      <h1>{t(lang, 'projects.title')}</h1>
      <p class="muted">{t(lang, 'projects.description')}</p>
      <p class="mono muted">{tn(lang, 'projects.count', projects.length)}</p>
    </header>
    <TagFilter lang={lang} tags={tags} />
    <ul class="rows projects" role="list">
      {projects.map((project, i) => (
        <li data-tags={project.data.tags.map(tagSlug).join(' ')}>
          <ProjectCard project={project} lang={lang} index={i + 1} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .projects {
    border-block: var(--border-w) solid var(--border);
  }
  .projects > [hidden] {
    display: none;
  }
</style>
