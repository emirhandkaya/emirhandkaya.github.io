---
// Project as an editorial row: big index | title, role, summary, tags | arrow.
import { localizedPath, t, type Lang } from '../i18n';
import { slugOf } from '../lib/posts';
import type { Project } from '../lib/projects';

export interface Props {
  project: Project;
  lang: Lang;
  index: number;
  level?: 2 | 3;
}

const { project, lang, index, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const d = project.data;
const href = localizedPath(lang, `projects/${slugOf(project)}`);
---

<article class="row project-row">
  <p class="index" aria-hidden="true">
    {String(index).padStart(2, '0')}
  </p>
  <div class="body">
    <p class="row-meta">
      {d.date && <span>{d.date.getUTCFullYear()} · </span>}
      <span class="status" data-status={d.status}>
        {t(lang, `projects.statuses.${d.status}`)}
      </span>
      {d.role && <span> · {d.role}</span>}
    </p>
    <Heading class="row-title">
      <a href={href}>{d.title}</a>
    </Heading>
    <p class="muted summary">{d.summary}</p>
    <ul class="tags" role="list" aria-label={t(lang, 'projects.tags')}>
      {d.tags.map((tag) => (
        <li>#{tag}</li>
      ))}
    </ul>
  </div>
  <span class="row-arrow" aria-hidden="true">
    →
  </span>
</article>

<style>
  .index {
    font-family: var(--font-mono);
    font-size: var(--step-4);
    line-height: var(--leading-display);
    color: var(--accent);
  }
  .body {
    display: grid;
    gap: var(--space-2);
  }
  .row-title {
    font-size: var(--step-2);
    letter-spacing: var(--tracking-tight);
  }
  .summary {
    max-width: var(--measure);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .status[data-status='active']::before {
    content: '';
    display: inline-block;
    width: var(--space-2);
    height: var(--space-2);
    margin-inline-end: var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--accent);
  }
</style>
