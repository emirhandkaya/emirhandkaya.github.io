---
import { SOCIALS } from '../data/site';
import { localizedPath, t, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <ul class="cluster socials" role="list" aria-label={t(lang, 'a11y.social')}>
      {SOCIALS.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            {t(lang, `social.${s.id}`)}
            <span class="visually-hidden">{t(lang, 'a11y.newTab')}</span>
          </a>
        </li>
      ))}
      <li>
        <a href={`${localizedPath(lang)}rss.xml`} aria-label={t(lang, 'footer.rssLabel')}>
          {t(lang, 'footer.rss')}
        </a>
      </li>
    </ul>
    <p class="muted copy">{t(lang, 'footer.copyright', { year })}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-w) solid var(--border);
    margin-block-start: var(--space-8);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }
  .socials {
    list-style: none;
    padding: 0;
    --cluster-space: var(--space-1) var(--space-3);
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .socials a:hover {
    color: var(--text);
  }
  .copy {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
