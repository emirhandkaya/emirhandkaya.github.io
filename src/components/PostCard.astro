---
// Post as an editorial row: date + reading time | title, excerpt, tags | arrow.
import TagList from './TagList.astro';
import { formatDate, localizedPath, t, type Lang } from '../i18n';
import { describe, slugOf, type Post } from '../lib/posts';
import { readingTime } from '../lib/readingTime';

export interface Props {
  post: Post;
  lang: Lang;
  level?: 2 | 3;
  /** Hide the excerpt (compact lists). */
  compact?: boolean;
}

const { post, lang, level = 2, compact = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const href = localizedPath(lang, `blog/${slugOf(post)}`);
const date = post.data.date;
---

<article class="row post-row">
  <p class="row-meta">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(lang, date)}</time>
    <br />
    {t(lang, 'blog.readingTime', { n: readingTime(post.body ?? '') })}
  </p>
  <div class="body">
    <Heading class="row-title">
      <a href={href}>{post.data.title}</a>
    </Heading>
    {!compact && <p class="muted excerpt">{describe(post)}</p>}
    {!compact && <TagList lang={lang} tags={post.data.tags} />}
  </div>
  <span class="row-arrow" aria-hidden="true">
    →
  </span>
</article>

<style>
  .body {
    display: grid;
    gap: var(--space-3);
  }
  .excerpt {
    max-width: var(--measure);
  }
</style>
