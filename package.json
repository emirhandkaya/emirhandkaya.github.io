{
  "name": "mysite",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/report.mjs check \"astro check\" \"eslint .\"",
    "links": "node scripts/report.mjs links \"linkinator dist --config linkinator.config.json\"",
    "lighthouse": "node scripts/report.mjs lighthouse \"lhci autorun\"",
    "i18n-parity": "node scripts/report.mjs i18n-parity \"node scripts/i18n-parity.mjs\"",
    "format": "prettier --write .",
    "resume-pdf": "astro build && node scripts/resume-pdf.mjs && astro build",
    "og-image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
